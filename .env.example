# Turso (если не задано — используется локальный файл file:local.db)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# Gemini — только на сервере, без NEXT_PUBLIC_ префикса!
GEMINI_API_KEY=
# Необязательно: принудительно выбрать модель. Иначе перебор 3.8 → 3.7 → 3.6 → 3.5 flash → 3.5 flash-lite
GEMINI_MODEL=
